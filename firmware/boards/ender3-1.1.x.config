# Klipper .config seed for Creality Ender-3 "1.1.x" Melzi boards (ATmega1284P).
# Follows config/printer-creality-ender3-2018.cfg: "firmware should be compiled
# for the AVR atmega1284p". 16 MHz, serial at 250000 baud (Klipper defaults).
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_AVR=y
CONFIG_MACH_atmega1284p=y
CONFIG_AVR_FREQ_16000000=y
CONFIG_SERIAL_BAUD=250000
