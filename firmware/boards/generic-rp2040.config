# Klipper .config seed for a generic RP2040 board (e.g. Raspberry Pi Pico), USB.
# Same choices as the SKR Pico preset: no bootloader, W25Q080 flash chip
# (Klipper default), USB communication. Other RP2040 boards may need a
# different flash chip or UART instead of USB: use Menuconfig.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_RPXXXX=y
CONFIG_MACH_RP2040=y
CONFIG_RPXXXX_FLASH_START_0100=y
CONFIG_RP2040_FLASH_W25Q080=y
CONFIG_RPXXXX_USB=y
