# Klipper .config seed for Creality 4.2.x boards (STM32F103, stock bootloader).
# Follows the header of Klipper's config/generic-creality-v4.2.7.cfg:
# "STM32F103 with a 28KiB bootloader and serial (on USART1 PA10/PA9)".
# 8 MHz crystal is Klipper's default clock reference for STM32F103.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32_FLASH_START_7000=y
CONFIG_STM32_CLOCK_REF_8M=y
CONFIG_STM32_SERIAL_USART1=y
CONFIG_SERIAL_BAUD=250000
