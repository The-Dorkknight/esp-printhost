# Klipper .config seed for RAMPS 1.3/1.4/1.6 on an Arduino Mega 2560.
# Follows config/generic-ramps.cfg: "firmware compiled for the AVR atmega2560".
# 16 MHz, serial at 250000 baud (Klipper defaults).
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_AVR=y
CONFIG_MACH_atmega2560=y
CONFIG_AVR_FREQ_16000000=y
CONFIG_SERIAL_BAUD=250000
