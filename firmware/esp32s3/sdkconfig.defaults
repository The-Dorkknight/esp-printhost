# Skipper Flipper ESP32-S3 firmware (work in progress). Compile-tested only.
CONFIG_IDF_TARGET="esp32s3"
# 2 MB is safe on every ESP32-S3 module; a larger chip simply leaves the rest unused.
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Console on the chip's native USB port (shows up as an "Espressif USB JTAG/serial debug unit")
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# No colour escape codes: the log is also shown on a web page
CONFIG_LOG_COLORS=n
# Captive portal: phones send long headers and open many sockets
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_MAX_SOCKETS=16
# Stop with a clear "stack overflow" message the moment any task runs off the end of its stack,
# instead of silently corrupting the memory below it.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
# Crash reports: a core dump in its own partition, read back after the restart (main/crash.c)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# micro SD card (G-code files): long file names, UTF-8 names
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
# 2026-10-27: the TCP/IP task stays on core 0 with WiFi, so it cannot hold off the printer link
# task (pinned to core 1, priority 10; see main/link.cpp)
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# 2026-10-27 speed-up (all builds): the chip ran at ESP-IDF's default 160 MHz; it is rated for 240.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# DECKHAND (2026-10-28): no table of error names (about 7 KB); errors show as a number, e.g. 0x107.
# CAPTAIN and SKIPPER turn it back on (tiers/*.defaults).
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
